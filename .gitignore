__pycache__/
*.pyc
.venv/
.env

# Saved SIAN result pages — ~49 MB of binary, and the parsed catalog below
# carries everything we need from them. Keep locally, out of git history.
indices/

# Downloaded scans and derivatives
data/*
scans/

# ...but the parsed catalog is the corpus manifest and is versioned, since the
# index PDFs it derives from are not in git and were saved by hand.
!data/catalog.jsonl

# generated prototype assets (embeds an archive page)
prototype/build/

# model venv
.venv-ocr/
.venv-htr/
.venv/

# transcription cache (per-machine work product, not source)
data/transcriptions/
data/pagecache/
data/spike_*.json

# ...and hand-read ground truth is versioned: it is the only check on whether
# the engine can be trusted on handwriting, and it took eyes to make.
!data/truth/
!data/truth/*.json
